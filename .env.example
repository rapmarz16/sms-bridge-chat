# Public HTTPS origin used by browsers. HTTPS is mandatory in production.
APP_BASE_URL=https://chat.example.com
SESSION_SECRET=replace-with-at-least-32-random-characters

# Persistent paths inside the container.
DATABASE_PATH=/data/chat.db
UPLOADS_PATH=/data/uploads
GROUP_NAME=Family Chat

# Select exactly one outbound/inbound bridge. Existing deployments that omit
# this setting continue to default to voipms for backward compatibility.
SMS_PROVIDER=android_gateway

# Android/SIM gateway (recommended local-phone deployment).
# Keep port 8080 private on the LAN; never forward it from the internet.
ANDROID_GATEWAY_URL=http://192.168.50.25:8080
ANDROID_GATEWAY_USERNAME=
ANDROID_GATEWAY_PASSWORD=
ANDROID_GATEWAY_PHONE_NUMBER=+14165551234
ANDROID_GATEWAY_DEVICE_ID=
ANDROID_GATEWAY_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret
# Must exactly match Settings > Webhooks > Signing Key in the Android app.
ANDROID_GATEWAY_WEBHOOK_SIGNING_KEY=replace-with-the-phone-webhook-signing-key
ANDROID_GATEWAY_SIM_NUMBER=1
ANDROID_GATEWAY_TTL_SECONDS=3600
ANDROID_GATEWAY_DELIVERY_REPORTS=true
ANDROID_GATEWAY_REQUEST_TIMEOUT_MS=15000
# Signed callbacks outside this clock window are rejected to prevent replay.
ANDROID_GATEWAY_WEBHOOK_MAX_SKEW_SECONDS=300
# Admin/health status becomes stale after three minutes without a phone event.
ANDROID_GATEWAY_HEALTH_STALE_SECONDS=180

# VoIP.ms alternative. These values are ignored when SMS_PROVIDER is
# android_gateway. Use the dedicated API password, never the portal password.
VOIPMS_API_USERNAME=
VOIPMS_API_PASSWORD=
VOIPMS_DID=
VOIPMS_WEBHOOK_SECRET=
VOIPMS_API_URL=https://voip.ms/api/v1/rest.php

# Keep false until did/dst/message are checked against the current account-portal
# sendSMS reference. The provider adapter refuses production sends without this.
VOIPMS_SENDSMS_PARAMS_VERIFIED=false

# Safe first-run default. Login requires DEV_OTP_BYPASS_CODE until SMS is enabled.
SMS_ENABLED=false
SMS_DAILY_LIMIT=100
SMS_MAX_ATTEMPTS=4
SMS_POLL_INTERVAL_MS=1000

TZ=America/Toronto
HOST=0.0.0.0
PORT=3000
# Keep false when the app is directly reachable. If a reverse proxy is the only
# route to the app, set its exact IP/CIDR (or comma-separated trusted ranges).
TRUST_PROXY=false
LOG_LEVEL=info
DEFAULT_PHONE_REGION=CA
SESSION_DAYS=30
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
MESSAGE_MAX_LENGTH=4000
SMS_TEXT_MAX_LENGTH=2048

# Development only. Never set this in production.
# DEV_OTP_BYPASS_CODE=123456

# The container entrypoint can match Unraid's nobody:users ownership.
PUID=99
PGID=100
# Compose host paths (use /mnt/user/appdata/sms-bridge-chat on Unraid).
APPDATA_PATH=./data
CONFIG_PATH=./config
