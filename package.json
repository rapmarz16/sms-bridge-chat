{
  "name": "sms-bridge-chat",
  "version": "0.1.0",
  "private": true,
  "description": "A private, self-hosted group chat where SMS is an alternate client.",
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "vite --host 0.0.0.0",
    "build": "npm run clean && npm run typecheck && npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "clean": "node scripts/clean.mjs",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "security:audit": "npm audit --omit=dev",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "create-admin": "node dist/server/cli/create-admin.js",
    "create-admin:dev": "tsx src/server/cli/create-admin.ts",
    "configure-android-gateway": "node dist/server/cli/configure-android-gateway.js",
    "configure-android-gateway:dev": "tsx src/server/cli/configure-android-gateway.ts",
    "db:migrate": "node dist/server/cli/migrate.js",
    "db:migrate:dev": "tsx src/server/cli/migrate.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.5.0",
    "libphonenumber-js": "^1.12.13",
    "pino": "^9.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "sharp": "^0.34.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
